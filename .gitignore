token.json
.runtime/
*.duckdb
__pycache__/
*.pyc
.venv/
.env

# The Odds API key (the-odds-api.com) -- a real credential, never committed.
# Read once at fetch time by ingest.py's odds source.
.odds_api_key

# Quarto renders of reports/latest.md. Every workflow does `git add -A reports`,
# so without this a local render gets committed by the next bot run.
reports/latest.html
reports/latest_files/

# Today's market slate, pasted into the `seen` workflow input. Scratch, not
# state: every workflow does `git add -A inputs`, and a committed slate would
# be read by tomorrow's run as if it were still current.
inputs/seen.txt

# The parse cache: rows keyed by page CONTENT, so lxml runs only over
# documents it has not seen. Derived from data/raw, rebuilt on demand, and
# invalidated whole when sources.py changes — nothing here is evidence.
data/tidy/parsed.json
# The parse cache, now line-oriented so a tail append can read a few entries
# out of it without loading 89MB. Derived from data/raw and rebuilt on
# demand, so it is ignored exactly as its single-blob predecessor was.
# parse_state.json is NOT ignored: it records which snapshots and which
# parser signatures the tracked tidy tables were built from, and it has to
# travel with them or a clone cannot tell whether they are current.
data/tidy/parsed.jsonl
data/tidy/startcal.json

# Claude Code worktrees and session state -- never part of the repo.
.claude/
