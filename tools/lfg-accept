#!/usr/bin/env bash
# Do the lines accepted on the report page, and write the results back beside it.
#
# Its own unit on a short timer (lfg-accept.timer), so a press is not held
# behind the minute lfg-watch waits, nor behind a run it has in flight.

set -uo pipefail

DEST="${LIST_DATA_DIR:-$HOME/list-data}/fantasy"
STATE="$HOME/.local/state/lfg"
mkdir -p "$STATE"

# Lines accepted on the report page, a file a press in accept/ (the server
# renames each in whole): each taken by renaming it into taken/, so a press
# landing meanwhile stays for the next round, then read and removed there,
# where nothing but this writes. Placed by act.py (each checked against the
# board as it stands now), and the results written back beside the report as
# act.json. Not held behind a run in flight: a bid waits for nothing the run
# makes. accept.json is the server's older single-file queue, taken the same way.
ACC=
if [ -d "$DEST" ]; then
    mkdir -p "$DEST/taken"
    for f in "$DEST"/accept/*.json "$DEST/accept.json"; do
        [ -e "$f" ] && mv "$f" "$DEST/taken/"
    done
    ACC=$(cat "$DEST"/taken/* 2>/dev/null; rm -f "$DEST"/taken/*)
fi
if [ -n "$ACC" ]; then
    echo "accepted: $ACC"
    # One request a line, or (accept.json) a list of them: act.py takes a list.
    printf '%s\n' "$ACC" | python3 -c '
import json, sys
out = []
for line in sys.stdin:
    if line.strip():
        got = json.loads(line)
        out.extend(got if isinstance(got, list) else [got])
json.dump(out, sys.stdout)' > "$STATE/accept.json"
    REPO="${LFG_REPO:-$HOME/claude_projects/liga_five_guys}"
    if ! (cd "$REPO" && PYTHONPATH=src "$HOME/.local/bin/uv" run --frozen python src/act.py accept \
            "$STATE/accept.json" > "$STATE/act.json" 2> "$STATE/act.err"); then
        python3 - "$STATE/accept.json" "$STATE/act.err" "$STATE/act.json" <<'PYEOF'
import datetime, json, sys
asked = json.load(open(sys.argv[1]))
err = open(sys.argv[2], encoding="utf-8").read().strip().splitlines()[-1:] or ["no output"]
at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
json.dump([{**r, "state": "failed", "message": "the box could not act: " + err[0][:200], "at": at}
           for r in (asked if isinstance(asked, list) else [asked])], open(sys.argv[3], "w"))
PYEOF
    fi
    cat "$STATE/act.json"; echo
    cp "$STATE/act.json" "$DEST/.act.json.$$" && mv "$DEST/.act.json.$$" "$DEST/act.json"
fi
