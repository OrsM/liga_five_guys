#!/usr/bin/env bash
# src/run.py on a scratch copy: data/raw linked in read-only, everything
# written (lfg.db, reports) under the scratch dir, nothing published or sent.
# For checking and timing a change; the tracked repo is never touched.
#
#     tools/lfg-dry-run              every stage
#     tools/lfg-dry-run sim grade    just those, as run.py takes them

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"
SCRATCH="${HOME}/.cache/lfg-dry-run"     # not /tmp: a tmpfs too small for lfg.db
mkdir -p "$SCRATCH/data" "$SCRATCH/reports"
ln -sfn "$REPO/data/raw" "$SCRATCH/data/raw"

export PYTHONPATH=src FF_ROOT="$SCRATCH/data" LFG_REPORTS="$SCRATCH/reports" LFG_NO_PUBLISH=1
echo "lfg-dry-run: scratch=$SCRATCH"
"$HOME/.local/bin/uv" run --frozen python src/run.py "$@"
