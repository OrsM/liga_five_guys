#!/usr/bin/env bash
# grading.py rules on a scratch copy: the live database is read once through a mode=ro connection and
# backed up into the scratch, the parse cache (data/tidy/parsed.jsonl, snapindex.json) copied as plain files, data/raw linked in, the replay and scoring run under tools/capped
# (LFG_CAP, 1500M by default; LFG_CAPPED names another wrapper), the scratch deleted after
# (LFG_KEEP=1 keeps it). Prints rule_report's table and `seconds S peak_mb M`.
# For re-checking a change over every past cutoff; the tracked repo is never touched.
#
#     tools/lfg-rules

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"
SCRATCH="${LFG_SCRATCH:-$HOME/.cache/lfg-rules}"       # not /tmp: a tmpfs too small for lfg.db; LFG_SCRATCH: one each when several run at once
CAPPED="${LFG_CAPPED:-$REPO/tools/capped}"
TREE="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"     # the tracked tree that holds data/, also from a worktree
LIVE="$TREE/data/lfg.db"
if [ ! -x "$CAPPED" ]; then
    echo "lfg-rules: $CAPPED is missing (tools/capped is not merged yet: ~/.cache/lfg-capped-wt/tools/capped); set LFG_CAPPED to it" >&2
    exit 1
fi
[ -z "${LFG_KEEP:-}" ] && trap 'rm -rf "$SCRATCH"' EXIT
rm -rf "$SCRATCH"
mkdir -p "$SCRATCH/data/tidy"
cp "$TREE/data/tidy/parsed.jsonl" "$TREE/data/tidy/snapindex.json" "$SCRATCH/data/tidy/"
ln -sfn "$TREE/data/raw" "$SCRATCH/data/raw"
python3 - "$LIVE" "$SCRATCH/data/lfg.db" <<'PY'
import sqlite3
import sys
src = sqlite3.connect("file:%s?mode=ro" % sys.argv[1], uri=True)
dst = sqlite3.connect(sys.argv[2])
src.backup(dst)
dst.close()
src.close()
PY

export PYTHONPATH=src FF_ROOT="$SCRATCH/data"
start=$SECONDS
status=0
/usr/bin/time -v -o "$SCRATCH/time" "$CAPPED" "$HOME/.local/bin/uv" run --frozen python src/grading.py rules \
    > "$SCRATCH/out" 2> "$SCRATCH/err" || status=$?
if [ "$status" -ne 0 ]; then
    case "$status" in
        137|143) echo "lfg-rules: killed by the memory cap (exit $status, LFG_CAP=${LFG_CAP:-1500M})" >&2 ;;
        *) echo "lfg-rules: failed (exit $status): $(tail -1 "$SCRATCH/err")" >&2 ;;
    esac
    exit "$status"
fi
peak_kb=$(awk '/Maximum resident set size/ {print $NF}' "$SCRATCH/time")
cat "$SCRATCH/out"
echo "seconds $((SECONDS - start)) peak_mb $((peak_kb / 1024))"
