#!/usr/bin/env bash
# liga_five_guys end to end, on this box (lfg.service, lfg-remind.service,
# lfg-watch): self-tests alongside the fetch, then src/run.py (every stage:
# STAGES there), then the report committed and, with LFG_PUSH=1, pushed.
# Exit 1 if a step that makes the report failed. Why each step is as it is:
# the first version of this file (git log -p tools/lfg-run).

set -euo pipefail

REPO="${LFG_REPO:-$HOME/claude_projects/liga_five_guys}"
UV="$HOME/.local/bin/uv"
cd "$REPO"

# One run at a time, whoever asks; a later one waits up to ten minutes.
mkdir -p "$HOME/.local/state/lfg"
exec 9>"$HOME/.local/state/lfg/run.lock"
if ! flock -w 600 9; then
    echo "another run held the lock for ten minutes — giving up" >&2
    exit 1
fi

export PYTHONPATH=src
export FF_ROOT=./data

log() { printf '%s  %s\n' "$(TZ=Europe/Madrid date +'%H:%M:%S %Z')" "$*"; }
RUN_T0=$(date +%s)
STAGE_T0=$RUN_T0
mark() { local now; now=$(date +%s)
        log "  (${1}: $(( now - STAGE_T0 ))s)"; STAGE_T0=$now; }
# In this shell, not a pipe: journald tags a line by the process that wrote it.
indent() { while IFS= read -r line; do printf '  %s\n' "$line"; done; }

log "self-tests"
ST_OUT="$(mktemp)"
trap 'rm -f "$ST_OUT"' EXIT
bash tools/selftests.sh >"$ST_OUT" 2>&1 &
ST_PID=$!

log "fetch"
"$UV" run --frozen python src/ingest.py fetch || { log "FAILED: fetch"; exit 1; }
mark fetch

# Both touch data/: a failure beside the fetch is re-run alone before it counts.
if wait "$ST_PID"; then
    indent < "$ST_OUT"
else
    log "  self-tests failed alongside the fetch -- re-running alone to confirm"
    if ! bash tools/selftests.sh 2>&1 | indent; then
        log "self-tests failed — refusing to build a report"
        exit 1
    fi
fi
mark self-tests

log "run"
"$UV" run --frozen python src/run.py || { log "FAILED: run"; exit 1; }
mark run

log "commit"
if [ -n "$(git status --porcelain data reports inputs)" ]; then
    git add -A data reports inputs
    git -c user.name='report-bot' -c user.email='report-bot@users.noreply.github.com' \
        commit -q -m "report: $(date -u +%Y-%m-%dT%H%MZ)"
    log "  committed"
    if [ "${LFG_PUSH:-}" = "1" ]; then
        # -X theirs is the commit being replayed: this run's report wins.
        if ! git pull --rebase --autostash -X theirs -q 2>/dev/null; then
            git rebase --abort 2>/dev/null || true
            log "  pull --rebase failed — a real conflict, needs a human"
        fi
        git push -q 2>/dev/null || log "  push failed (commit is local, will go next run)"
    fi
else
    log "  nothing changed"
fi
mark commit
log "done ($(( $(date +%s) - RUN_T0 ))s total)"
